{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Workout Tracker",
  "version": "0.9.0",
  "identifier": "com.timgoodchild.workouttracker",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "enableGTKAppId": true,
    "windows": [
      {
        "title": "Workout Tracker",
        "width": 1180,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY5QkVBMERDMkJFQUQ5RTgKUldUbzJlb3IzS0MrK1dubUs0WUZKZEh6UEVKaGFqODI4VGdCbEFjM2hLK05mRDdyL1VMaEIzdFUK",
      "endpoints": ["https://github.com/timgoodchild04/workout-tracker/releases/latest/download/latest.json"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": { "desktopTemplate": "linux/app.desktop" }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "targets": "all",
    "category": "HealthcareAndFitness",
    "icon": [
      "icons/icon.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
